{
  "name": "kyo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' vite --port ${PORT:-5173}",
    "dev:win": "vite --port 5173",
    "dev:worker": "wrangler dev",
    "preview:cloudflare": "bun run build && wrangler dev",
    "deploy:cloudflare": "bun run build && wrangler deploy",
    "version:bump": "bun run scripts/generate-build-version.ts --bump",
    "prebuild": "bun run scripts/generate-build-version.ts",
    "build": "tsc -b && vite build",
    "check:migration": "bun run scripts/check-migration-readiness.ts",
    "configure:cloudflare-env": "bun run scripts/configure-cloudflare-env.ts",
    "verify:worker": "bun run scripts/verify-worker-smoke.ts",
    "types:worker": "wrangler types src/worker/env.d.ts --env-file .dev.vars.example --include-runtime false --env-interface WorkerBindings",
    "build:tauri": "bun run scripts/build-tauri.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:icons": "bun run scripts/generate-icon-manifest.ts",
    "generate:infinite-mac-thumbnails": "bun run scripts/generate-infinite-mac-thumbnails.ts",
    "generate:average-colors": "bun run scripts/compute-average-colors.ts",
    "generate:wallpapers": "bun run scripts/generate-wallpaper-manifest.ts",
    "generate:app-docs": "bun run scripts/generate-app-docs.ts",
    "generate:changelog": "bun run scripts/generate-changelog.ts",
    "generate:docs": "bun run scripts/generate-app-docs.ts && bun run scripts/generate-changelog.ts && bun run scripts/generate-docs.ts",
    "launch-kiosk": "bash scripts/launch-kiosk.sh",
    "i18n:extract": "bun run scripts/extract-strings.ts",
    "i18n:sync": "bun run scripts/sync-translations.ts",
    "i18n:sync:dry-run": "bun run scripts/sync-translations.ts --dry-run",
    "i18n:sync:mark-todo": "bun run scripts/sync-translations.ts --mark-untranslated",
    "i18n:find-untranslated": "bun run scripts/find-untranslated-strings.ts",
    "i18n:translate": "bun run scripts/machine-translate.ts",
    "i18n:translate:dry-run": "bun run scripts/machine-translate.ts --dry-run",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "bash -c 'set -a && [ -f .env.local ] && source .env.local; set +a && tauri build --target universal-apple-darwin'",
    "tauri:build:mac:signed": "bash scripts/build-dmg.sh",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "test": "bun run tests/run-all-tests.ts",
    "test:api": "bun run tests/run-all-tests.ts",
    "test:worker": "bun run tests/test-worker-api.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.23",
    "@mastra/core": "^1.47.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@supabase/supabase-js": "^2.96.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tiptap/core": "^2.27",
    "@tiptap/extension-task-item": "^2.27",
    "@tiptap/extension-task-list": "^2.27",
    "@tiptap/extension-text-align": "^2.27",
    "@tiptap/extension-underline": "^2.27",
    "@tiptap/pm": "^2.27",
    "@tiptap/react": "^2.27",
    "@tiptap/starter-kit": "^2.27",
    "@tiptap/suggestion": "^2.27",
    "@types/dompurify": "^3.2.0",
    "@types/three": "^0.176.0",
    "@types/uuid": "^10.0.0",
    "@upstash/redis": "^1.36.0",
    "ai": "^6.0.49",
    "baseline-browser-mapping": "^2.9.11",
    "bcryptjs": "^3.0.3",
    "caniuse-lite": "^1.0.30001762",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.26",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "ios-vibrator-pro-max": "^1.3.2",
    "leo-profanity": "^1.8.0",
    "next-themes": "^0.4.6",
    "openai": "^4.104.0",
    "opencc-js": "^1.0.5",
    "pako": "^2.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.176.0",
    "use-stick-to-bottom": "^1.1.1",
    "uuid": "^11.1.0",
    "wavesurfer.js": "^7.12.1",
    "xp.css": "^0.2.6",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260627.1",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.9.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/dotenv": "^8.2.3",
    "@types/formidable": "^3.4.6",
    "@types/node": "^22",
    "@types/node-fetch": "^2.6.13",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "esbuild": "0.27.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.58.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.2.0",
    "woff2": "^1.0.0",
    "wrangler": "^4.105.0"
  },
  "packageManager": "bun@1.3.5"
}
