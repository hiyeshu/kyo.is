{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyo-is",
  "account_id": "2e46d86d7ad223120aae0ebf077666c8",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-27",
