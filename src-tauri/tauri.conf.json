{
  "productName": "Kyo",
  "version": "1.0.0",
  "identifier": "is.kyo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Kyo",
        "url": "https://kyo.is",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "alwaysOnTop": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright Kyo",
    "category": "Utility",
    "shortDescription": "Web-Based Agentic AI OS",
    "longDescription": "Kyo.is - A web-based agentic AI operating system experience",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "infoPlist": "./Info.plist",
      "entitlements": "./entitlements.plist",
      "signingIdentity": "Developer ID Application: SHU YE (X689MYAJ7K)",
      "providerShortName": "X689MYAJ7K",
      "hardenedRuntime": true
    },
    "windows": {
      "digestAlgorithm": "sha256"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
